bool image_lowk_valid(char *image_path, int argc) {
    if (argc == 1) {
        printf("Please provide a path to an image");
        return false;
    }

    const char supported_filetypes[3][10] = {
        ".jpg",
        ".jpeg",
        ".png"
    };

    const char *filetype = get_file_type(image_path);

 if (!filetype) {
        return false;
    }

    bool failed_thrice = true;

    for (int i = 0; i < 3; i++) {
        if (strcmp(filetype, supported_filetypes[i]) == 0) {
            printf("success");
            failed_thrice = false;
        }
    }
    if (failed_thrice) {
        printf("pls provide smth with one of these: \n");
        for (int i = 0; i < 3; i++) {
            printf("%s !\n", supported_filetypes[i]);
        }
        return false;
    }
    return true;
}
